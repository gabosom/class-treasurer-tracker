# Copy to .env.local for local development. Never commit real values.

# Demo mode: leave SHEET_ID unset and the app shows fictional data with no sign-in.
# Setting SHEET_ID switches to the real Sheet and turns sign-in on.

# Shared secret for cookies and sessions: openssl rand -base64 32
AUTH_SECRET=change-me
# Class code families type to see the dashboard
FAMILIES_CODE=prueba

# --- Production (Vercel) ---
# GOOGLE_READER_SA_JSON_B64=   base64 of the treasurer-reader service account key
# SHEET_ID=1KkmQm69pmdNL3-GcoDDpB8s_FIVYjPQziySqN3FrSLs   (unset = demo mode)
# AUTH_GOOGLE_ID=              OAuth Web client for directiva sign-in
# AUTH_GOOGLE_SECRET=
# NEXTAUTH_URL=https://<production-domain>   must match the OAuth redirect URI
# OWNER_EMAIL=gabosom@gmail.com              always allowed into /directiva, even if the Sheet is broken
